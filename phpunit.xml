<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" : sans ça, des variables DB_* exportées dans le shell (ou héritées de l’IDE) peuvent
        écraser ces valeurs → les tests RefreshDatabase migrent alors sur TA base de dev et la VIDENT.
        `tests/bootstrap.php` ré-impose aussi DB_* + `PHPUNIT_GUARD_DATABASE` ; `tests/TestCase.php` refuse
        toute base dont le nom ≠ `PHPUNIT_GUARD_DATABASE` (défaut `laravel` = base jetable ; ne pas pointer vers ta base principale).
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL requis : POINT spatial ; base **tests** uniquement : CREATE DATABASE laravel; (ne pas utiliser ta base principale) -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="PHPUNIT_GUARD_DATABASE" value="laravel" force="true"/>
        <env name="DB_DATABASE" value="laravel" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DEMO_USERS_COUNT" value="500" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="POST_NOTIFICATIONS_QUEUE_DRIVER" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="TYPESENSE_SYNC_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
