APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional plain-text token prefix (e.g. "osport_" for log scanners). Leave empty for none.
SANCTUM_TOKEN_PREFIX=

# --- Stripe (Laravel Cashier) — ne jamais committer les vraies clés ---
STRIPE_KEY=
STRIPE_SECRET=
# Secret du webhook : en local, sortie de `stripe listen` (whsec_...). En prod, secret du endpoint Dashboard.
STRIPE_WEBHOOK_SECRET=
# Prix récurrent mensuel (price_...), pas le produit seul (prod_...).
STRIPE_SUBSCRIPTION_PRICE_ID=
# Référence produit Stripe (optionnel, documentation / contrôle métier).
STRIPE_PRODUCT_ID=
BILLING_SUBSCRIPTION_TYPE=default
# Essai gratuit en jours après souscription (0 = désactivé). Ex. 30 pour un mois approximatif.
BILLING_SUBSCRIPTION_TRIAL_DAYS=0
# URLs de retour Checkout (React Native). Stripe remplace {CHECKOUT_SESSION_ID} dans success_url.
# Exemple local : http://127.0.0.1:8000 (ou schéma d’app myapp://...)
BILLING_CHECKOUT_SUCCESS_URL="${APP_URL}/billing/checkout/return?result=success&session_id={CHECKOUT_SESSION_ID}"
BILLING_CHECKOUT_CANCEL_URL="${APP_URL}/billing/checkout/return?result=cancel"

# Typesense (Scout / recherche). Défauts alignés sur un serveur local standard.
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
# Clé par défaut d’une instance Typesense locale « out of the box » ; à changer en prod.
TYPESENSE_API_KEY=xyz
